# Copia este archivo a .env:  cp .env.example .env
# Aquí NO van secretos: las contraseñas y claves viven en ./secrets/*.txt
# (ver README raíz, "Puesta en marcha") y compose las monta en /run/secrets/.

# --- App ---
APP_NAME=NexaAgent
ENVIRONMENT=development
JWT_EXPIRES_HOURS=24

# --- Ollama (LLM local) ---
# El modelo de chat debe soportar tool-calling de forma fiable. qwen2.5 es el
# validado en el proyecto; llama3.1 no invocaba las herramientas de forma
# consistente (ver Docs/BITACORA-parte-2.md).
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Debe coincidir con la salida del modelo de embeddings. Cambiarlo obliga a
# recrear la BD (docker compose down -v).
EMBEDDING_DIM=768

# --- PostgreSQL ---
# La contraseña NO va aquí: va en ./secrets/postgres_password.txt.
POSTGRES_USER=nexa
POSTGRES_DB=nexaagent

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# --- Opcionales (descomenta para cambiar el valor por defecto) ---
# Zona horaria con la que se crean eventos de Google Calendar.
# CALENDAR_TIMEZONE=America/Mexico_City
# Orígenes permitidos por CORS (lista JSON). Por defecto, Vite en el puerto 5173.
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
