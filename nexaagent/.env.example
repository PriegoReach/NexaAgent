# Copia este archivo a .env:  cp .env.example .env
# Aquí NO van secretos: las contraseñas y claves viven en ./secrets/*.txt
# (ver README raíz, "Puesta en marcha") y compose las monta en /run/secrets/.

# --- App ---
APP_NAME=NexaAgent
ENVIRONMENT=development
JWT_EXPIRES_HOURS=24

# --- Ollama (LLM local) ---
# El modelo de chat debe soportar tool-calling de forma fiable. qwen2.5 es el
# validado en el proyecto; llama3.1 no invocaba las herramientas de forma
# consistente (ver Docs/BITACORA-parte-2.md).
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Debe coincidir con la salida del modelo de embeddings. Cambiarlo obliga a
# recrear la BD (docker compose down -v).
EMBEDDING_DIM=768

# --- PostgreSQL ---
# La contraseña NO va aquí: va en ./secrets/postgres_password.txt.
POSTGRES_USER=nexa
POSTGRES_DB=nexaagent

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# --- Opcionales (descomenta para cambiar el valor por defecto) ---
# Tu zona horaria: la de los eventos de Google Calendar y la que decide qué día es
# "hoy" al entender "mañana" o "el viernes".
# CALENDAR_TIMEZONE=America/Mexico_City
# Orígenes permitidos por CORS (lista JSON). Por defecto, Vite en el puerto 5173.
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Recordatorios: un resumen diario de las tareas de hoy y las vencidas. Llega por
# Gmail a este correo (con la cuenta de Google conectada); sin correo, por el webhook.
# REMINDER_EMAIL=tu@correo.com
# A partir de qué hora local (0-23, la de CALENDAR_TIMEZONE) se manda.
# REMINDER_HOUR=8
# Dominios que http_get puede consultar siempre (lista JSON, incluye subdominios).
# Sin esto, solo los que escribas en la conversación.
# HTTP_GET_ALLOWED_DOMAINS=["wttr.in","api.github.com"]
# La web guarda la sesión en una cookie httpOnly. Si sirves Nexa por HTTPS, ponlo a
# true para que la cookie solo viaje cifrada (con http://localhost debe quedar false).
# SESSION_COOKIE_SECURE=true
